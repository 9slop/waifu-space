# Supabase & Application Environment Configuration
# Copy this file to .env (or .env.local for local dev) and fill in your
# Supabase project credentials. Server-side code reads these from process.env
# at runtime; on deployment platforms (Vercel etc.) set them in the platform
# environment instead.

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: publishable key (new Supabase API Keys). Used as a client-side
# fallback for the anon key if SUPABASE_ANON_KEY is not set.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# JWT Session Signing Secret
JWT_SECRET=waifu-space-production-jwt-secret-replace-me

# App URL (e.g. for Vercel deployment)
APP_URL=https://waifu-space.vercel.app
