# Supabase & Application Environment Configuration
# Copy this file to .env and fill in your Supabase project credentials.

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Session Signing Secret
JWT_SECRET=waifu-space-production-jwt-secret-replace-me

# App URL (e.g. for Vercel deployment)
APP_URL=https://waifu-space.vercel.app
